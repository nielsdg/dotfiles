[user]
    name = Niels De Graef
    email = nielsdegraef@gmail.com
[color]
    ui = true
[core]
    editor = nvim
[push]
    default = current
[help]
    autocorrect = 1
[advice]
    statusHints = false
[github]
    user = nielsdg
[alias]
    branches = branch -a
    tags = tag
    stashes = stash list
    uncommit = reset --mixed HEAD~
    fuckit = !git reset --hard HEAD && git clean -d -f
    stash-unapply = !git stash show -p | git apply -R
    wip = !git add -A && git commit -m 'WIP'
